# The single .env for this repo — read by docker-compose.yml (for ${VAR}
# interpolation and, via `env_file`, by the backend container) and by the
# backend itself (config/env.ts) whether you run `npm run dev` locally or
# `docker compose up`. There is no second file under backend/.
#
# This repo runs backend + postgres only — the frontend is a separate
# project/repo and isn't orchestrated from here. Point it at this backend
# via NEXT_PUBLIC_API_URL=http://localhost:<BACKEND_PORT>/api in its own env.
#
# Copy this to .env before running `docker compose up`.

# ---------------------------------------------------------------------------
# Orchestration — host ports and Postgres credentials. DATABASE_URL is derived
# from POSTGRES_* by config/env.ts for local runs, and set explicitly by
# docker-compose for in-network runs. Only set it yourself to point at a
# different database (e.g. a real hosted Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
# ---------------------------------------------------------------------------
BACKEND_PORT=5000
# Published to the host so local (non-Docker) `npm run dev` can reach the
# same Postgres — non-standard default since 5432 is often already taken.
POSTGRES_PORT=5435

POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TOKEN_TTL=1h

COOKIE_SECRET=dev-cookie-secret-change-me

# Platform admin (oversees all tenants) — deliberately a different secret
# from JWT_ACCESS_SECRET, see config/env.ts.
PLATFORM_JWT_ACCESS_SECRET=dev-platform-access-secret-change-me
PLATFORM_ACCESS_TOKEN_TTL=15m
PLATFORM_REFRESH_TOKEN_TTL=7d

# Two-factor code delivery: Brevo for email OTPs, Vynfy for SMS OTPs. Leaving
# these blank is the normal development setup — the code is written to the
# server log instead of being sent (see lib/otp-delivery.ts). Codes are only
# ever logged outside production; with NODE_ENV=production a blank provider is
# a hard error, so a code that was never delivered can't look like a success.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Inventory Manager
VYNFY_API_KEY=
VYNFY_SENDER_ID=
# Override only if Vynfy's endpoint differs from the default — see lib/sms.ts.
VYNFY_BASE_URL=https://sms.vynfy.com
VYNFY_SEND_PATH=/api/v1/send
OTP_CODE_TTL=10m
PENDING_TWO_FACTOR_AUTH_TTL=10m
REMEMBERED_DEVICE_TTL=30d

# Used only by prisma/seed.ts (npm run db:seed) — not read by the running server.
SEED_PLATFORM_ADMIN_EMAIL=admin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_DEMO_OWNER_EMAIL=owner@demo.local
SEED_DEMO_OWNER_PASSWORD=
SEED_DEMO_BUSINESS_NAME=Demo Store
# Shared password for the demo staff accounts created by `npm run db:seed:demo`
# (one per non-owner role). Defaults to DemoStaff123! when blank.
SEED_DEMO_STAFF_PASSWORD=
