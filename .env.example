# Used by docker-compose.yml for orchestration-level values only — things
# that don't belong to one single app. Backend secrets/config live in
# backend/.env (the same file whether you run it locally or via Docker);
# see docker-compose.yml's `env_file` on the backend service.
#
# Copy this to .env before running `docker compose up`.

# Host ports the frontend and backend are published on.
BACKEND_PORT=5000
FRONTEND_PORT=3000

POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# The browser calls the backend directly (no reverse proxy in front), so this
# must be an absolute URL matching BACKEND_PORT above. Baked in at build
# time, so changing it requires `docker compose build frontend` again.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
