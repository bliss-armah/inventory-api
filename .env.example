# The single .env for this repo — read by docker-compose.yml (which interpolates
# ${VAR} into the backend container's `environment` block) and by the backend
# itself (config/env.ts) whether you run `npm run dev` locally or through
# compose. There is no second file under backend/.
#
# Production (Dokploy) reads none of this: docker-compose.yml is the production
# stack, and its values come from the service's Environment tab. See
# DEPLOYMENT.md.
#
# This repo runs backend + postgres only — the frontend is a separate
# project/repo and isn't orchestrated from here. Point it at this backend
# via NEXT_PUBLIC_API_URL=http://localhost:<BACKEND_PORT>/api in its own env.
#
# Copy this to .env, then:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d

# ---------------------------------------------------------------------------
# Orchestration — local only (docker-compose.local.yml): host ports and
# Postgres credentials. DATABASE_URL is derived from POSTGRES_* by
# config/env.ts for local runs, and set explicitly by the local compose
# override for in-network runs. Only set it yourself to point at a different
# database (e.g. a real hosted Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
# ---------------------------------------------------------------------------
BACKEND_PORT=5000
# Published to the host so local (non-Docker) `npm run dev` can reach the
# same Postgres — non-standard default since 5432 is often already taken.
POSTGRES_PORT=5435

POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Self-service signup. Businesses are normally created by a platform admin via
# POST /api/platform/tenants, so this stays false; POST /api/auth/register then
# 403s. Must be the literal string "true" to open public registration.
ALLOW_PUBLIC_REGISTRATION=false

JWT_ACCESS_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TOKEN_TTL=1h

COOKIE_SECRET=dev-cookie-secret-change-me

# Platform admin (oversees all tenants) — deliberately a different secret
# from JWT_ACCESS_SECRET, see config/env.ts.
PLATFORM_JWT_ACCESS_SECRET=dev-platform-access-secret-change-me
PLATFORM_ACCESS_TOKEN_TTL=15m
PLATFORM_REFRESH_TOKEN_TTL=7d

# Transactional email through Brevo: password resets and invitations. Leaving
# these blank is the normal development setup — the message is written to the
# server log instead of being sent. With NODE_ENV=production a blank provider
# is a hard error.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Inventory Manager
# Product image storage: Cloudflare R2, addressed with the S3 API. The bucket
# stays private — product responses carry a presigned URL that expires after an
# hour, so the bucket needs no public access and no bound domain.
# Leave blank for local development — images are written to backend/uploads/
# and served from /uploads instead. In production these are required: an
# unconfigured store is a hard error rather than a silent fallback to a disk
# that does not survive a redeploy.
# R2_ENDPOINT is the account's S3 endpoint,
# https://<account_id>.r2.cloudflarestorage.com — or a MinIO URL locally.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

BUSINESS_SELECTION_TTL=10m

# Used only by prisma/seed.ts (npm run db:seed) — not read by the running server.
# That seed creates the platform admin and nothing else: every business and its
# owner are created from /platform/dashboard once you sign in as this admin.
SEED_PLATFORM_ADMIN_EMAIL=admin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=

# Used only by prisma/seed-demo.ts (npm run db:seed:demo), which builds a
# throwaway demo business — catalogue, stock, and one worked example of every
# stock-moving flow. Never run this against a real deployment.
# Passwords under 8 characters are ignored and a random one is generated and
# printed instead, so set a real one here if you want a password you chose.
SEED_DEMO_OWNER_EMAIL=owner@demo.local
SEED_DEMO_OWNER_PASSWORD=
SEED_DEMO_BUSINESS_NAME=Demo Store
# Shared password for the demo staff accounts (one per non-owner role).
# Defaults to DemoStaff123! when blank.
SEED_DEMO_STAFF_PASSWORD=
